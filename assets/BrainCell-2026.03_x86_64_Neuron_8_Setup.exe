@echo off
REM Launches the MICrONS workbench GUI in the "micronsimport" conda environment.
REM Anaconda is not on PATH, so locate conda.bat directly (same as ViewSynapsesOnMorphology.bat).
set CONDA_BAT=
if exist "%USERPROFILE%\anaconda3\condabin\conda.bat" (
    set CONDA_BAT=%USERPROFILE%\anaconda3\condabin\conda.bat
) else if exist "%USERPROFILE%\Anaconda3\condabin\conda.bat" (
    set CONDA_BAT=%USERPROFILE%\Anaconda3\condabin\conda.bat
) else if exist "%USERPROFILE%\miniconda3\condabin\conda.bat" (
    set CONDA_BAT=%USERPROFILE%\miniconda3\condabin\conda.bat
) else if exist "C:\ProgramData\Anaconda3\condabin\conda.bat" (
    set CONDA_BAT=C:\ProgramData\Anaconda3\condabin\conda.bat
)
if "%CONDA_BAT%"=="" (
    echo Could not find conda.bat. Edit CONDA_BAT near the top of this file.
    pause
    exit /b 1
)
call "%CONDA_BAT%" activate micronsimport
if errorlevel 1 (
    echo Could not activate the "micronsimport" environment.
    pause
    exit /b 1
)
python "%~dp0MICrONS_GUI.py"
if errorlevel 1 pause
